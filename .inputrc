# https://man.archlinux.org/man/readline.3#keyseq
set keyseq-timeout 120

# turn on vim for readline
set editing-mode vi

# show the current vim mode in the prompt (bash >= v4.4 only)
set show-mode-in-prompt on
set vi-cmd-mode-string "\1\033[1;35m\2 NOR \1\033[m\2"
set vi-ins-mode-string "\1\033[1;32m\2 INS \1\033[m\2"
# set vi-cmd-mode-string "\1\033[1;35m\2 ❮ \1\033[m\2"
# set vi-ins-mode-string "\1\033[1;32m\2 ❯ \1\033[m\2"

# LC_COLORS
set colored-stats on
set colored-completion-prefix on

# completion
set show-all-if-ambiguous on
set visible-stats on
set completion-ignore-case on
set menu-complete-display-prefix on
set completion-map-case on
set show-all-if-ambiguous on
set completion-prefix-display-length 5
set page-completions off

# Set the bell-style to be visible only i.e no audio played on command completion
# can also be set to none
set bell-style visible

# Opt-t to transpose the two preceding words (Insert Mode)
"\et":transpose-words

#vi mode settings
$if mode=vi
    set keymap vi-command
    "D":kill-line
    "C":"Da"
    "dw":kill-word
    "dd":kill-whole-line
    "db":backward-kill-word
    "cc":"ddi"
    "cw":"dwi"
    "cb":"dbi"
    "daw":"lbdW"
    "yaw":"lbyW"
    "caw":"lbcW"
    "diw":"lbdw"
    "yiw":"lbyw"
    "ciw":"lbcw"
    "gg":beginning-of-history
    "G":end-of-history
    # switch to block cursor before executing a command
    # leave this at the very bottom.
    set keymap vi-insert
    RETURN: "\e\n"
$endif

# bindings, ledger
"lac": "ledger balance --real ^Asset:Liquid ^Liability"
"lav": "ledger balance --empty --begin '\''12 months ago'\'' --amount '\''amount / 12'\'' ^Expense"
"lbu": "ledger balance ^Asset:Budget"
";aa": "ledger register --real --tail "
";bb": "ledger register --limit \"not real\" --tail "

